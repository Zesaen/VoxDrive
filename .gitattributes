# 换行符统一：仓库内一律 LF，防止 Windows 开发污染板上脚本
* text=auto
*.sh   text eol=lf
*.py   text eol=lf
*.cpp  text eol=lf
*.cc   text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf
*.c    text eol=lf
*.md   text eol=lf
*.conf text eol=lf
*.txt  text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
